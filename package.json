{
  "name": "storyboard",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:e2e": "vitest run tests/e2e/file-to-pwa.test.ts tests/e2e/pwa-to-file.test.ts tests/e2e/mcp-tools.test.ts tests/e2e/resilience.test.ts --fileParallelism=false",
    "test:e2e:visual": "vitest run tests/e2e/ --fileParallelism=false",
    "server:start": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "test:server": "vitest run server/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^5.0.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.0",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "mime-types": "^3.0.2",
    "nanoid": "^5.0.4",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.21.0",
    "unified": "^11.0.5",
    "ws": "^8.20.0",
    "yaml": "^2.8.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/react": "^18.2.43",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.2.17",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fake-indexeddb": "^5.0.2",
    "postcss": "^8.4.32",
    "selenium-webdriver": "^4.15.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^1.0.0"
  }
}
